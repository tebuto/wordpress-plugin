{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"files": {
		"includes": [
			"tebuto-online-terminbuchung/block/src/**",
			"tebuto-online-terminbuchung/js/**",
			"!**/node_modules",
			"!**/build",
			"!wordpress",
			"!vendor",
			"!**/*.scss"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedVariables": "warn",
				"noUnusedImports": "warn",
				"useExhaustiveDependencies": "off",
				"useHookAtTopLevel": "error"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noConsole": "off",
				"noArrayIndexKey": "off"
			},
			"style": {
				"noNonNullAssertion": "warn",
				"useConst": "warn",
				"noUnusedTemplateLiteral": "off",
				"useImportType": "off",
				"noParameterAssign": "off"
			},
			"complexity": {
				"noForEach": "off",
				"useLiteralKeys": "off",
				"noUselessFragments": "off"
			},
			"a11y": {
				"useKeyWithClickEvents": "off",
				"useButtonType": "off",
				"useSemanticElements": "off",
				"noStaticElementInteractions": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded",
			"trailingCommas": "none"
		}
	},
	"json": {
		"formatter": {
			"indentStyle": "tab"
		}
	}
}
