#toplevel_page_tebuto-main > a > div.wp-menu-image.dashicons-before > img {
  width: 18px !important;
  height: 18px !important;
  max-width: 100%;
  max-height: 100%;
  display: inline-block;
  vertical-align: middle;
}

#toplevel_page_tebuto-main
  > a
  > div.wp-menu-image.dashicons-before:hover
  > img {
  filter: brightness(0) saturate(100%) invert(50%) sepia(50%) saturate(500%)
    hue-rotate(180deg) brightness(90%);
}
